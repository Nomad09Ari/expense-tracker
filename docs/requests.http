### API-г frontend-гүйгээр шалгах
#
# VS Code дээр "REST Client" өргөтгөл суулгасан байх шаардлагатай.
# Хүсэлт бүрийн дээр "Send Request" гэсэн жижиг холбоос гарч ирнэ. Дар.
# Хариу нь хажууд шинэ таб дээр гарна — status code, header, body бүгд.
#
# npm run dev ажиллаж байх ёстой.
#
# Хүсэлтүүдийг ### мөрөөр тусгаарладаг. Тэрийг битгий устгаарай.


@host = http://localhost:3000

# Vercel дээрээ шалгах бол дээрх мөрийг тайлбар болгоод доорхийг ашигла:
# @host = https://<чиний-апп>.vercel.app


###############################################################################
# ДОЛОО ХОНОГ 2 — Зардлын API
###############################################################################

### Бүх зардлыг авах
# Хүлээж байгаа: 200 + массив
GET {{host}}/api/expenses


### Шинэ зардал нэмэх
# Хүлээж байгаа: 201 + үүссэн зардал
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": 12000,
  "category": "food",
  "note": "Өдрийн хоол",
  "date": "2026-03-02"
}


### Зардал нэмэх — тэмдэглэлгүй
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": 3500,
  "category": "transport",
  "date": "2026-03-02"
}


###############################################################################
# ШАЛГАЛТ ажиллаж байгаа эсэх — бүгд 400 буцаах ёстой
###############################################################################

### Дүн нь тоо биш
# Хүлээж байгаа: 400 + { "error": "..." }
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": "гурван мянга",
  "category": "food",
  "date": "2026-03-02"
}


### Дүн сөрөг
# Хүлээж байгаа: 400
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": -500,
  "category": "food",
  "date": "2026-03-02"
}


### Дүн огт байхгүй
# Хүлээж байгаа: 400
POST {{host}}/api/expenses
Content-Type: application/json

{
  "category": "food",
  "date": "2026-03-02"
}


### Байхгүй ангилал
# Хүлээж байгаа: 400
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": 5000,
  "category": "puppies",
  "date": "2026-03-02"
}


###############################################################################
# Устгах, засах
# <ID> хэсгийг бодит id-гаар соль (GET-ийн хариунаас хуулж ав)
###############################################################################

### Дүнг өөрчлөх
# Хүлээж байгаа: 200 + шинэчилсэн зардал
PATCH {{host}}/api/expenses/<ID>
Content-Type: application/json

{
  "amount": 15000
}


### Зардал устгах
# Хүлээж байгаа: 204 (эсвэл 200)
DELETE {{host}}/api/expenses/<ID>


### Байхгүй зардлыг устгах
# Хүлээж байгаа: 404 — 500 БИШ
DELETE {{host}}/api/expenses/ene-id-baihgui


### Байхгүй зардлыг өөрчлөх
# Хүлээж байгаа: 404
PATCH {{host}}/api/expenses/ene-id-baihgui
Content-Type: application/json

{
  "amount": 999
}


###############################################################################
# ДОЛОО ХОНОГ 4 — Нэвтрэлт
###############################################################################

### Бүртгүүлэх
# Хүлээж байгаа: 201. Хариунд нууц үг БАЙХГҮЙ байх ёстой
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "bat@example.com",
  "password": "nuutsug123"
}


### Ижил и-мэйлээр дахин бүртгүүлэх
# Хүлээж байгаа: 400
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "bat@example.com",
  "password": "өөр-нууц-үг"
}


### Нэвтрэх
# Хүлээж байгаа: 200 + Set-Cookie header.
# Хариуны "Headers" хэсгээс Set-Cookie байгаа эсэхийг хараарай.
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "bat@example.com",
  "password": "nuutsug123"
}


### Буруу нууц үгээр нэвтрэх
# Хүлээж байгаа: 401.
# Алдааны мессеж нь и-мэйл бүртгэлтэй эсэхийг ИЛЧЛЭХГҮЙ байх ёстой
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "bat@example.com",
  "password": "buruu-nuuts-ug"
}


### Одоогийн хэрэглэгч хэн бэ
# Хүлээж байгаа: нэвтэрсэн бол 200, эсрэг тохиолдолд 401
GET {{host}}/api/auth/me


### Гарах
POST {{host}}/api/auth/logout


###############################################################################
# ЭРХИЙН ШАЛГАЛТ — өөрийгөө халдах дасгал (Даалгавар 4.2)
#
# Дараалал:
#   1. Хэрэглэгч А-гаар нэвтэр
#   2. Зардал нэмээд түүний id-г хуулж ав
#   3. Гар (logout)
#   4. Хэрэглэгч Б-гээр бүртгүүлж нэвтэр
#   5. Доорх хүсэлтүүдийг илгээ
###############################################################################

### Хоёр дахь хэрэглэгч үүсгэх
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "saraa@example.com",
  "password": "nuutsug456"
}


### Хоёр дахь хэрэглэгчээр нэвтрэх
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "saraa@example.com",
  "password": "nuutsug456"
}


### Жагсаалт харах
# Хүлээж байгаа: 200 + ХООСОН массив.
# А-гийн зардал энд харагдвал GET дээрх шүүлт дутуу байна.
GET {{host}}/api/expenses


### ⚠️ Өөр хүний зардлыг устгах гэж оролдох
# <А-ГИЙН-ЗАРДЛЫН-ID> хэсгийг сольж илгээ.
#
# Хүлээж байгаа: 403
#
# Хэрэв 204 ирж, зардал устсан бол — эзний шалгалт дутуу байна.
# Энэ бол жинхэнэ аюул. Заавал зас.
DELETE {{host}}/api/expenses/<А-ГИЙН-ЗАРДЛЫН-ID>


### ⚠️ Өөр хүний зардлыг өөрчлөх гэж оролдох
# Хүлээж байгаа: 403
PATCH {{host}}/api/expenses/<А-ГИЙН-ЗАРДЛЫН-ID>
Content-Type: application/json

{
  "amount": 1
}


### ⚠️ Өөр хүний нэрээр зардал үүсгэх гэж оролдох
# body дотор userId илгээж байна. Сервер үүнийг ЗӨВШӨӨРӨХГҮЙ байх ёстой —
# зардал нь cookie-гийн эзэнд харьяалагдана, энэ userId-д биш.
#
# Илгээсний дараа GET хийж, зардал ХЭНД харьяалагдсаныг шалгаарай.
POST {{host}}/api/expenses
Content-Type: application/json

{
  "amount": 9999,
  "category": "other",
  "note": "Хэний зардал болох вэ?",
  "date": "2026-03-02",
  "userId": "<А-ГИЙН-USER-ID>"
}


### Нэвтрээгүй үед хандах
# Эхлээд logout хий, дараа нь илгээ.
# Хүлээж байгаа: 401
GET {{host}}/api/expenses
